# =====================================================================
# Modèle de configuration — copie ce fichier en `.env` puis remplis-le.
#   cp .env.example .env
# Le fichier `.env` contient tes identifiants : ne le partage JAMAIS et
# ne le committe JAMAIS (il est exclu de git via .gitignore).
# =====================================================================

# URL de la page de connexion BLS Espagne (Algérie)
BLS_LOGIN_URL=https://algeria.blsinternational.com/

# Tes identifiants de compte BLS
BLS_EMAIL=ton.email@example.com
BLS_PASSWORD=ton-mot-de-passe

# Heure locale de début de la surveillance (heure d'ouverture des créneaux)
TARGET_HOUR=16
TARGET_MINUTE=55

# Intervalle MOYEN entre deux vérifications, en secondes.
# Un jitter aléatoire (±1,5 s) est appliqué automatiquement autour de
# cette valeur pour éviter un motif de requêtes périodiques fixes.
REFRESH_INTERVAL_SECONDS=5
