# =====================================================================
# Modèle de configuration — copie ce fichier en `.env` puis remplis-le.
#   cp .env.example .env
# Le fichier `.env` contient tes identifiants : ne le partage JAMAIS et
# ne le committe JAMAIS (il est exclu de git via .gitignore).
#
# Tout ce qui est commenté (#) est OPTIONNEL : la valeur par défaut
# convient pour un usage normal.
# =====================================================================

# ---------- Indispensable ----------

# URL de la page de connexion BLS Espagne (Algérie)
BLS_LOGIN_URL=https://algeria.blsinternational.com/

# Tes identifiants de compte BLS
BLS_EMAIL=ton.email@example.com
BLS_PASSWORD=ton-mot-de-passe

# Heure locale de début de la surveillance (heure d'ouverture des créneaux).
# Si tu lances le script APRÈS cette heure, il démarre la surveillance
# immédiatement (pas d'attente jusqu'au lendemain).
TARGET_HOUR=16
TARGET_MINUTE=55

# Intervalle MOYEN entre deux vérifications, en secondes (plancher : 2 s).
# Un jitter aléatoire (±1,5 s) est appliqué automatiquement autour de
# cette valeur pour éviter un motif de requêtes périodiques fixes.
REFRESH_INTERVAL_SECONDS=5

# ---------- Navigation vers le calendrier ----------

# Présélection automatique du premier jour disponible dès sa détection :
# t'affiche directement l'écran des créneaux horaires (le choix du créneau
# et la confirmation restent manuels). Mets 0 pour désactiver.
AUTO_CLICK_FIRST_DAY=1

# URL directe de la page du calendrier des créneaux. Si vide, le script
# essaie dans l'ordre : l'URL mémorisée au dernier lancement réussi
# (appointment_url.txt), un clic sur le lien « prendre rendez-vous », puis
# te laisse naviguer manuellement.
#APPOINTMENT_URL=https://algeria.blsinternational.com/es/fr/appointment

# ---------- Scan du mois suivant ----------

# Les créneaux s'ouvrent souvent pour le MOIS SUIVANT (le mois affiché est
# déjà saturé) : le script clique sur « mois suivant » et le vérifie aussi.
# Mets 0 pour ne surveiller que le mois affiché.
SCAN_NEXT_MONTH=1

# Ne scanner le mois suivant qu'une vérification sur N (limite les requêtes
# envoyées au site ; 1 = à chaque vérification).
#NEXT_MONTH_SCAN_EVERY=2

# ---------- Garde-fou « session expirée » ----------

# Si le site te déconnecte pendant la surveillance : tente d'abord une
# reconnexion automatique avec BLS_EMAIL/BLS_PASSWORD, puis bip + invite au
# terminal si un CAPTCHA/OTP bloque (jamais contourné). Mets 0 pour être
# seulement averti et te reconnecter toi-même.
AUTO_RELOGIN_ON_EXPIRY=1

# ---------- Auto-relance de Chrome ----------

# Échecs de chargement consécutifs avant de relancer Chrome tout seul.
#MAX_CONSECUTIVE_FAILURES=5

# Vérifications consécutives sans calendrier affiché avant de relancer Chrome
# (page blanche, onglet planté, structure du site changée…).
#MAX_NO_CALENDAR_ATTEMPTS=6

# Nombre maximal de relances automatiques : au-delà, le script s'arrête,
# sonne et te rend la main (le problème n'est alors plus transitoire).
#MAX_DRIVER_RECOVERIES=3

# Délais maximaux en secondes. Indispensables : sans eux, un chargement
# « pendu » bloque le script pour toujours et l'auto-relance ne se déclenche
# jamais.
#PAGE_LOAD_TIMEOUT_SECONDS=45
#SCRIPT_TIMEOUT_SECONDS=20
#CALENDAR_RENDER_TIMEOUT=10

# ---------- Compte à rebours et self-check ----------

# Self-check complet à T-<PREFLIGHT_MINUTES> : navigateur vivant (relancé si
# besoin), session active (reconnectée si possible), calendrier accessible.
#PREFLIGHT_MINUTES=30

# Contrôle léger à T-<FINAL_CHECK_MINUTES>, sans quitter la page : navigateur
# vivant et session en place. 0 = désactivé.
#FINAL_CHECK_MINUTES=2

# ---------- Tableau de bord local (bls_viewer.py) ----------

# Affiche en direct dans ton navigateur le compte à rebours, l'état de la
# session, les compteurs (vérifications, échecs, relances, reconnexions) et
# le journal des événements. Lecture seule, aucune dépendance à installer.
VIEWER_ENABLED=1

# Interface d'écoute : laisse 127.0.0.1 pour que le tableau de bord ne soit
# visible que depuis ton ordinateur (recommandé).
#VIEWER_HOST=127.0.0.1
#VIEWER_PORT=8765

# ---------- Dépannage ChromeDriver ----------

# Version majeure de Chrome (OPTIONNEL — laisse vide pour la détection
# automatique). À n'utiliser que si le script se trompe de ChromeDriver
# (erreur "This version of ChromeDriver only supports Chrome version X").
# Ouvre chrome://version dans Chrome : le premier nombre est la version
# majeure (ex: 151.0.7922.76 -> 151).
#CHROME_VERSION_MAIN=151
